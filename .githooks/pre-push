#!/bin/sh
# pre-push: repository identity + lost-update (remote race) protection.
#
# Refuses to push when the remote tip for a pushed branch contains commits that are
# NOT in the local history being pushed (a non-fast-forward would silently drop the
# other session's work). Also prints an advisory when the remote advanced beyond the
# session's recorded starting SHA from the writer lease.
#
# Exit codes: 86 identity failure | 88 unexpected remote advancement | other = git.
RACE_EXIT=88
IDENTITY_EXIT=86
ZERO=0000000000000000000000000000000000000000

root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$root" ]; then
    echo "pre-push: not inside a Git work tree." >&2
    exit "$IDENTITY_EXIT"
fi

sh "$root/scripts/assert-repo-identity.sh" "$root" || exit $?

lease_start=""
lease_file="$(git rev-parse --path-format=absolute --git-path simple-walk-game.writer-lock.json 2>/dev/null || echo "$root/.git/simple-walk-game.writer-lock.json")"
if [ -f "$lease_file" ]; then
    lease_start="$(sed -n 's/.*"startSha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$lease_file" | head -n 1)"
fi

status=0
while read -r local_ref local_oid remote_ref remote_oid; do
    # Deletions of remote branches carry an all-zero local OID; nothing to protect.
    [ "$local_oid" = "$ZERO" ] && continue
    # New remote branch: nothing to lose.
    [ "$remote_oid" = "$ZERO" ] && continue

    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
        echo "PRE-PUSH REFUSED ($RACE_EXIT): remote tip of '$remote_ref' is NOT part of the history you are pushing." >&2
        echo "  remote tip : $(git log --oneline -1 "$remote_oid" 2>/dev/null || echo "$remote_oid")" >&2
        echo "  local tip  : $(git log --oneline -1 "$local_oid" 2>/dev/null || echo "$local_oid")" >&2
        echo "" >&2
        echo "Pushing now would discard another session's commits (lost update)." >&2
        echo "Required procedure:" >&2
        echo "  1. git fetch origin" >&2
        echo "  2. inspect the incoming commits (do they touch overlapping areas?)" >&2
        echo "  3. reconcile deliberately (merge/rebase onto them), never reset them away" >&2
        echo "  4. re-run the full verification suite" >&2
        echo "  5. push again" >&2
        echo "force-push / hard-reset are forbidden conflict shortcuts absent explicit operator authorization." >&2
        status=$RACE_EXIT
        continue
    fi

    # Advisory: the writer lease remembers where this session started.
    if [ -n "$lease_start" ] && ! git merge-base --is-ancestor "$lease_start" "$remote_oid" 2>/dev/null; then
        echo "PRE-PUSH ADVISORY: origin moved beyond this session's starting SHA ($lease_start)." >&2
        echo "Verify the incoming commits were reconciled deliberately before integrating." >&2
    fi
done

exit $status
