    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WalkGame.Infrastructure\WalkGame.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WalkGame.Domain\WalkGame.Domain.csproj" />
  </ItemGroup>

</Project>
