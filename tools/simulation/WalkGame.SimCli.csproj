<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nullable and the warnings policy come from ../../Directory.Build.props.
       The CLI is the release-evidence tool, so it is covered by the same
       warnings-as-errors policy as the libraries (docs/DECISIONS.md D-051). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WalkGame.Domain\WalkGame.Domain.csproj" />
    <ProjectReference Include="..\..\src\WalkGame.Application\WalkGame.Application.csproj" />
    <ProjectReference Include="..\..\src\WalkGame.Infrastructure\WalkGame.Infrastructure.csproj" />
  </ItemGroup>

</Project>
